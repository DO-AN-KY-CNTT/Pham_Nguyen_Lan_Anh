<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_nutribudget_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_nutribudget_logo"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Pham_Nguyen_Lan_Anh">

        <!-- Login is the entry point launcher -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity (Trang chu + Bottom Navigation) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile activities -->
        <activity
            android:name=".ui.profile.ProfileDetailActivity"
            android:exported="true" />

        <activity
            android:name=".ui.profile.NutritionGoalsActivity"
            android:exported="true" />

        <activity
            android:name=".ui.profile.BudgetSettingsActivity"
            android:exported="true" />

        <!-- Meal and budget activities -->
        <activity
            android:name=".ui.meal.MealRecommendationActivity"
            android:exported="true" />

        <activity
            android:name=".ui.meal.MealDetailActivity"
            android:exported="true" />

        <activity
            android:name=".ui.meal.AdjustMealActivity"
            android:exported="true" />

        <activity
            android:name=".ui.meal.CostOverviewActivity"
            android:exported="true" />

        <activity
            android:name=".ui.meal.GroceryListActivity"
            android:exported="true" />

        <activity
            android:name=".ui.meal.MenuHistoryActivity"
            android:exported="true" />
    </application>

</manifest>
